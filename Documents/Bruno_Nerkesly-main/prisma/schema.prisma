// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Table des Utilisateurs (Connexion et inscription)
model User {
  id         String         @id @default(uuid())
  email      String         @unique
  password   String
  pseudonyme String         @unique
  entries    JournalEntry[]
}

// Table du Journal de bien-être (Section 2.3.1)
model JournalEntry {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  humeur     Int
  energie    Int
  sommeil    Int
  anxiete    Int
  evenements String

  // Contrainte obligatoire : Une seule entrée par jour pour un même utilisateur
  @@unique([userId, date])
}
